<?xml version="1.0" encoding="utf-8"?>
<!-- Uber-style palette — DARK mode. Place in res/values-night/colors.xml
     Keep the same resource NAMES as res/values/colors.xml — Android will
     automatically pick this file when the system is in dark mode. -->
<resources>

    <!-- Core -->
    <color name="uber_background">#000000</color>
    <color name="uber_surface">#1A1A1A</color>
    <color name="uber_surface_elevated">#2E2E2E</color>
    <color name="uber_primary_action">#FFFFFF</color>
    <color name="uber_on_primary_action">#000000</color>

    <!-- Accent (kept consistent across themes for brand recognition) -->
    <color name="uber_accent_blue">#276EF1</color>
    <!-- Lighter alt if you need more contrast against pure black: -->
    <color name="uber_accent_blue_light">#548BF4</color>

    <!-- Status (unchanged from light; brighten if contrast feels weak on black) -->
    <color name="uber_success">#048848</color>
    <color name="uber_warning">#FFC043</color>
    <color name="uber_error">#E11900</color>

    <!-- Text -->
    <color name="uber_text_primary">#FFFFFF</color>
    <color name="uber_text_secondary">#CBCBCB</color>
    <color name="uber_text_tertiary">#999999</color>
    <color name="uber_text_disabled">#666666</color>

    <!-- Borders / dividers (inferred — not explicitly published for dark mode) -->
    <color name="uber_border_subtle">#2E2E2E</color>
    <color name="uber_border_default">#3D3D3D</color>
    <color name="uber_divider">#333333</color>

    <!-- Full mono / gray ramp, inverted order of emphasis -->
    <color name="uber_mono_100">#000000</color>
    <color name="uber_mono_200">#1A1A1A</color>
    <color name="uber_mono_300">#2E2E2E</color>
    <color name="uber_mono_400">#333333</color>
    <color name="uber_mono_500">#545454</color>
    <color name="uber_mono_600">#666666</color>
    <color name="uber_mono_700">#999999</color>
    <color name="uber_mono_800">#B3B3B3</color>
    <color name="uber_mono_900">#CBCBCB</color>
    <color name="uber_mono_1000">#FFFFFF</color>

</resources>
